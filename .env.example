# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
# `python setup.py` writes this file for you — editing by hand is optional.
#
# `.env` is only for running the scripts on your own machine (setup, testing).
# For the Claude Code cloud routine, set the same variables as secrets on the
# routine's cloud environment instead — real environment variables always
# override `.env`.
#
# --- Gmail (required) -----------------------------------------------------
# Reading Gmail uses the Gmail API over HTTPS (IMAP/SMTP are blocked in the
# cloud sandbox). Sending the digest uses the Gmail API too.
# Get these via the one-time setup (see docs/SETUP.md):
#   1. Google Cloud Console -> create/pick a project -> enable the "Gmail API".
#   2. OAuth consent screen: User type External, add your gmail as a Test user.
#   3. Credentials -> Create OAuth client ID -> Application type "Desktop app".
#   4. python setup.py   (or: python gmail_oauth_setup.py)  -> refresh token.
GMAIL_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
GMAIL_REFRESH_TOKEN=1//xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GMAIL_USER=you@gmail.com

# --- Digest delivery (optional) -------------------------------------------
# Recipient override. If unset, the digest goes to <local>+digest@<domain>
# derived from GMAIL_USER (handy for a dedicated filter/label + phone alert).
DIGEST_TO=
