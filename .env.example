# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
#
# Reading Gmail uses the Gmail API over HTTPS (IMAP is blocked in the cloud
# sandbox). The daily digest is delivered as the routine's own output (a Claude
# notification) — no email is sent, so READ-ONLY access is all that is needed.
#
# One-time setup to get these values:
#   1. Google Cloud Console -> create/pick a project -> enable the "Gmail API".
#   2. OAuth consent screen: User type External, add your gmail as a Test user.
#   3. Credentials -> Create OAuth client ID -> Application type "Desktop app".
#   4. python gmail_oauth_setup.py --client-id <id> --client-secret <secret>
#      -> approve (read-only) in the browser -> it prints GMAIL_REFRESH_TOKEN.
GMAIL_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
GMAIL_REFRESH_TOKEN=1//xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional — only if you also want send_digest.py to EMAIL the digest. That
# needs the gmail.send scope added back in gmail_common.py and a re-auth.
GMAIL_USER=you@gmail.com
