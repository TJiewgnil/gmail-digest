# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
# `python setup.py` writes this file for you — editing by hand is optional.
#
# Real environment variables always override `.env`, so in GitHub Actions you set
# these as repository Secrets/Variables instead of committing a .env.
#
# --- Gmail (required for all deployments) ---------------------------------
# Reading Gmail uses the Gmail API over HTTPS (IMAP/SMTP are blocked in many
# sandboxes). Sending the digest uses the Gmail API too.
# Get these via the one-time setup (see docs/SETUP.md):
#   1. Google Cloud Console -> create/pick a project -> enable the "Gmail API".
#   2. OAuth consent screen: User type External, add your gmail as a Test user.
#   3. Credentials -> Create OAuth client ID -> Application type "Desktop app".
#   4. python setup.py   (or: python gmail_oauth_setup.py)  -> refresh token.
GMAIL_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
GMAIL_REFRESH_TOKEN=1//xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GMAIL_USER=you@gmail.com

# --- Anthropic API (required for GitHub Actions & local cron paths) --------
# Not needed for the Claude Code routine path (Claude Code is the summarizer).
# Get a key at https://console.anthropic.com/ . Daily cost is a few cents.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
# Model used by summarize.py. Default is claude-haiku-4-5 (cheapest/fastest).
# For higher-quality summaries use e.g. claude-sonnet-4-5.
ANTHROPIC_MODEL=claude-haiku-4-5

# --- Digest delivery (optional) -------------------------------------------
# Recipient override. If unset, the digest goes to <local>+digest@<domain>
# derived from GMAIL_USER (handy for a dedicated filter/label + phone alert).
DIGEST_TO=
# How many hours of mail each run looks back over.
DIGEST_HOURS=24
